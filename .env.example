# Copie para .env e preencha. O .env NUNCA vai para o Git.

# Banco (usado pelo docker-compose e pelo back-end)
DB_NAME=sgd
DB_USERNAME=sgd
DB_PASSWORD=troque-esta-senha
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/sgd

# JWT: chave com pelo menos 32 caracteres
JWT_SECRET=troque-por-uma-chave-aleatoria-com-32-caracteres-ou-mais
JWT_EXPIRATION_MS=3600000

# Perfil do Spring: "mock" enquanto a API da faculdade não chega
SPRING_PROFILES_ACTIVE=mock
FACULDADE_API_URL=http://localhost:9090
# Senhas dos usuários do mock (login: admin / aluno). Sem valor, o usuário não consegue logar.
MOCK_SENHA_ADMIN=
MOCK_SENHA_ALUNO=

CORS_ALLOWED_ORIGINS=http://localhost:4200
